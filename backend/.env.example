# Local, synthetic examples only. Never deploy demo mode publicly.
BUGBRIEF_MODE=demo
INFERENCE_MODE=examples
DEMO_DATABASE=.data/demo.sqlite3
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# For real login/database: BUGBRIEF_MODE=production and fill these server-only values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# For actual CPU inference: INFERENCE_MODE=transformers; install requirements-model.in.
# Pin both revisions to commit IDs before deployment.
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
MODEL_REVISION=
ADAPTER_PATH=
ADAPTER_REVISION=
GENERATION_TIMEOUT_SECONDS=180

# Local v2 pipeline: run python scripts/configure_v2.py from the project root.
# The profile verifies downloaded weights and training provenance before loading.
MODEL_PROFILE_PATH=
MODEL_DEVICE=cpu
MODEL_CPU_THREADS=2
CONSTRAINED_OUTPUT=true
# none preserves float32 inference; int8 merges the adapter in memory then quantizes CPU linear layers.
MODEL_CPU_QUANTIZATION=none
